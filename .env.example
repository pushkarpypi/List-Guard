# ==============================================================================
# List Guard - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your live/sandbox credentials.
# Do NOT commit .env.local to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shopify Partner / App Credentials
# Create an app in https://partners.shopify.com
SHOPIFY_CLIENT_ID="your_shopify_client_id_here"
SHOPIFY_CLIENT_SECRET="your_shopify_client_secret_here"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpss_your_admin_access_token_here"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_hmac_secret_here"
SHOPIFY_PUBSUB_SERVICE_ACCOUNT="delivery@shopify-pubsub-webhooks.iam.gserviceaccount.com"

# Supabase Configuration
# Create a project at https://supabase.com and run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key_here"

# Google Gemini AI API Key
# Get a key at https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# Paddle Billing (v2) Configuration
# Get credentials at https://vendors.paddle.com
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="live_your_paddle_client_token_here"
PADDLE_API_KEY="your_paddle_api_key_here"
PADDLE_WEBHOOK_SECRET="your_paddle_webhook_secret_here"
NEXT_PUBLIC_PADDLE_ENV="sandbox" # or "production"

# Transactional Alerts (Optional)
# https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
ALERT_FROM_EMAIL="alerts@listguard.dev"
CRON_SECRET="your_secure_cron_secret_phrase"
